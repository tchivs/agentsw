{
  "name": "agentsw",
  "version": "0.7.1",
  "description": "CLI provider switcher for coding agents: manage OpenAI/Anthropic-protocol providers in one place and sync them, with models.dev metadata, into Claude Code, Codex, omp, pi, prime-agent, opencode, Hermes, WorkBuddy and DeepSeek Harness",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tchivs/agentsw.git"
  },
  "homepage": "https://github.com/tchivs/agentsw#readme",
  "bugs": "https://github.com/tchivs/agentsw/issues",
  "keywords": [
    "cli",
    "coding-agent",
    "model-provider",
    "provider-switcher",
    "claude-code",
    "codex",
    "opencode",
    "deepseek-harness",
    "models.dev",
    "cc-switch"
  ],
  "license": "MIT",
  "bin": {
    "agentsw": "dist/index.js",
    "asw": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
